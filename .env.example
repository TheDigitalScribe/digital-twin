# ---------------------------------------------------------------------------
# Digital Twin — environment configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Required: OpenAI (or OpenAI-compatible) API key.
OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (Azure, vLLM, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: chat model name (must be compatible with the tools used).
# MODEL_NAME=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Candidate background (the "CV" the twin represents)
# ---------------------------------------------------------------------------
# Set TWIN_BACKGROUND to the full background text, e.g.:
#   TWIN_BACKGROUND="Contact
#   name@example.com
#   https://linkedin.com/in/username
#   Skills: Python, Kubernetes...
#   Experience: ..."
# (Multi-line values are supported in .env files.)
TWIN_BACKGROUND=

# Optional: override the default behavior/tone instructions appended after
# the core (non-overridable) security protocols.
# TWIN_BEHAVIOR=

# ---------------------------------------------------------------------------
# Model / cost bounds
# ---------------------------------------------------------------------------
# Maximum tokens the model may generate per response (cost/latency bound).
# MAX_OUTPUT_TOKENS=1024
# Maximum characters of the background (CV) returned by retrieve_background
# (prevents a single tool call from blowing up the context window).
# MAX_BACKGROUND_CHARS=25000
# Per-attempt timeout (seconds) for a single chat-completions call.
# LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Lead capture persistence
# ---------------------------------------------------------------------------
# SQLite path for durable lead/question storage. Relative paths resolve
# against the repository root. Set to empty to disable persistence.
# LEADS_DB_PATH=data/leads.db

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Conversation limits (cost / injection-surface control)
# ---------------------------------------------------------------------------
# MAX_MESSAGE_CHARS=500
# MAX_HISTORY_TURNS=10

# ---------------------------------------------------------------------------
# Trusted reverse proxies (comma-separated IPs).
# Only these peers may supply X-Forwarded-For for rate limiting. Leave empty
# if not running behind a proxy. Use 0.0.0.0/0 ONLY in single-tenant setups.
# ---------------------------------------------------------------------------
# TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO